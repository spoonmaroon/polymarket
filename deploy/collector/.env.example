POLYMARKET_UID=1000
POLYMARKET_GID=1000
POLYMARKET_DATA_DIR=/home/spoon/polymarket-data
POLYMARKET_DISPLAY_TZ=America/Chicago
POLYMARKET_API_PORT=8000
POLYMARKET_ENABLE_CONTAINER_STATUS=1
POLYMARKET_ENABLE_RUNTIME_PROBABILITIES=0
POLYMARKET_ALLOW_RUNTIME_PROBABILITY_COMPUTE=0

# Read-only Rust state-manager collector.
POLYMARKET_ASSETS=BTC,ETH
POLYMARKET_INTERVAL=5m
POLYMARKET_PREWARM_WINDOWS=2
POLYMARKET_NORMALIZER_INTERVAL_SECONDS=0.25
POLYMARKET_COLLECTOR_IMAGE=polymarket-rust-collector:latest
POLYMARKET_NORMALIZER_IMAGE=polymarket-normalizer:latest
POLYMARKET_CUDA_PROBABILITY_IMAGE=polymarket-cuda-probability:latest
POLYMARKET_STATUS_INTERVAL_MS=100
POLYMARKET_PROBABILITY_INPUTS_PATH=/var/lib/polymarket/live/probability_inputs.json
POLYMARKET_PROBABILITY_FRAGMENTS_PATH=/var/lib/polymarket/live/probability_fragments.json
POLYMARKET_OUTCOME_STATUS_PATH=/var/lib/polymarket/live/outcomes.json
POLYMARKET_ENABLE_OUTCOME_REFRESH=1
POLYMARKET_OUTCOME_REFRESH_INTERVAL_SECONDS=30
POLYMARKET_VOLATILITY_STATUS_PATH=/var/lib/polymarket/live/volatility.json
POLYMARKET_BUG_REPORT_DIR=/var/lib/polymarket/live/bug-reports
POLYMARKET_OFFICIAL_OUTCOME_SOURCE=clob
POLYMARKET_OFFICIAL_OUTCOME_TIMEOUT_SECONDS=2.0
POLYMARKET_OFFICIAL_OUTCOME_REFRESH_LIMIT=4
POLYMARKET_OFFICIAL_OUTCOME_PENDING_SWEEP_LIMIT=20
POLYMARKET_OUTCOME_OUTPUT_LIMIT=5000
POLYMARKET_PROBABILITY_WORKER_MODE=ensemble
POLYMARKET_ENSEMBLE_GENERATOR_POLICY=all_four_every_cycle
POLYMARKET_CUDA_PROBABILITY_MAX_INPUT_SNAPSHOT_AGE_SECONDS=30.0
POLYMARKET_PROBABILITY_CPU_TARGET_PERCENT=15.0
POLYMARKET_PROBABILITY_CPU_SOFT_MAX_PERCENT=20.0
POLYMARKET_PROBABILITY_MAX_RSS_MB=512
POLYMARKET_PROBABILITY_MAX_CYCLE_RUNTIME_MS=10000
POLYMARKET_PROBABILITY_MAX_TOTAL_PATHS=320000
POLYMARKET_PROBABILITY_MIN_TOTAL_PATHS=80000
POLYMARKET_PROBABILITY_SUSTAINED_BREACH_CYCLES=3
POLYMARKET_ENSEMBLE_FRAGMENT_MAX_ROWS=250000
POLYMARKET_ENSEMBLE_CPU_THREADS=1
POLYMARKET_GPU_WORKER_CPUS=1.0
POLYMARKET_GPU_WORKER_MEM_LIMIT=1536m
POLYMARKET_DUCKDB_THREADS=1
POLYMARKET_DUCKDB_MEMORY_LIMIT=512MiB
POLYMARKET_DUCKDB_PRESERVE_INSERTION_ORDER=false
POLYMARKET_STATE_SNAPSHOT_INTERVAL_MS=5000
POLYMARKET_PREWARM_BEFORE_EXPIRY_MS=30000
POLYMARKET_STALE_CHAINLINK_AFTER_MS=5000
POLYMARKET_STALE_ORDERBOOK_AFTER_MS=30000
POLYMARKET_REST_BACKUP_INTERVAL_MS=1000
POLYMARKET_RAW_EVENT_BUFFER_SIZE=16384
POLYMARKET_DECISION_EVENT_BUFFER_SIZE=16384

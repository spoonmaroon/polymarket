[Unit]
# Retired fallback/manual runner. The Python live collector must not be restarted.
Description=RETIRED Polymarket Python live collector tombstone
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=spoon
WorkingDirectory=/home/spoon/polymarket
Environment=PATH=/home/spoon/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8

ExecStart=/bin/sh -c 'echo "Python Polymarket live collector is retired. Use rust/polymarket-live-probe."; exit 64'

StandardOutput=append:/home/spoon/polymarket/logs/live_collector.systemd.stdout.log
StandardError=append:/home/spoon/polymarket/logs/live_collector.systemd.stderr.log

[Install]
WantedBy=multi-user.target
